# Copia este archivo a ".env" y llena tus valores reales
# En Render, estas mismas variables se agregan en el panel (Environment), no como archivo .env

# --- Twilio (WhatsApp) ---
# La consigues gratis en console.twilio.com (cuenta de prueba/trial)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# El número del Sandbox de WhatsApp que te da Twilio, con el formato "whatsapp:+14155238886"
TWILIO_WHATSAPP_NUMBER=

# Clave que tú inventas para proteger el panel /admin (donde el barbero responde manualmente)
# Ejemplo: una palabra larga y única, como "peluqueria2026secreta"
ADMIN_SECRET=

# API key gratis de Google Gemini, para el respaldo de IA cuando no se detecta palabra clave clara
# La sacas gratis (sin tarjeta) en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Nombre del barbero (se usa en los mensajes del bot)
BARBER_NAME=Peña

# URL pública que Render te da para este servicio, ej: https://barber-bot.onrender.com
# Se usa para el auto-ping y así el servicio no se duerma
PUBLIC_URL=

# Puerto (Render lo asigna automáticamente, no lo toques en producción)
PORT=3000

# --- Base de datos Neon (Postgres) ---
# La sacas de neon.tech -> tu proyecto -> Connection string (elige "Pooled connection")
DATABASE_URL=

# --- Google Sheets (copia automática de citas) ---
# Correo de la cuenta de servicio de Google Cloud, ej: barber-bot@tu-proyecto.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Clave privada de la cuenta de servicio (el bloque "private_key" del JSON descargado).
# En Render pégala tal cual, con los \n incluidos como texto.
GOOGLE_PRIVATE_KEY=
# El ID de la hoja de cálculo (está en la URL: docs.google.com/spreadsheets/d/ESTE_ID/edit)
GOOGLE_SHEET_ID=
